# Never put provider keys in NEXT_PUBLIC_* variables.
APP_MODE=replay
DEMO_ACCESS_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
